# premarket-ai vendor-sim (Python 3.13, FastAPI).
# Build context: python/vendor-sim
#   podman build -f podman/vendor-sim/Containerfile --target runtime python/vendor-sim
# Stages: base -> test (pytest), lint (ruff), runtime (default).

FROM docker.io/library/python:3.13-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

# ---------------------------------------------------------------------------
FROM base AS dev
COPY pyproject.toml ./
COPY src ./src
RUN pip install -e ".[dev]"
COPY tests ./tests

FROM dev AS test
RUN pytest -q

FROM dev AS lint
RUN ruff check src tests && ruff format --check src tests

# ---------------------------------------------------------------------------
FROM base AS runtime
COPY pyproject.toml ./
COPY src ./src
RUN pip install . && rm -rf src \
 && useradd --system --uid 10001 --home-dir /app vendor \
 && mkdir -p /data && chown vendor /data
USER vendor
ENV DATA_DIR=/data
EXPOSE 8080
# The healthcheck lives in compose.yaml (OCI images drop HEALTHCHECK).
CMD ["uvicorn", "vendor_sim.app:app", "--host", "0.0.0.0", "--port", "8080"]
