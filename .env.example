# premarket-ai settings. Copy to .env (gitignored) and adjust:
#   cp .env.example .env
# Later increments add their keys and switches here.

# --- PostgreSQL (local lab only; pick any password) -------------------------
POSTGRES_PASSWORD=change-me-local-only

# --- vendor-sim: the synthetic news vendor ----------------------------------
# Same seed + date = same 100 items and labels.
VENDOR_SEED=42
# Items per day by kind (injection is a subset of fake). Empty = defaults.
VENDOR_MIX=real=60,fake=15,injection=2,misleading=10,duplicates=15

# --- legacy C++11 ingester ---------------------------------------------------
LEGACY_WORKERS=4
LEGACY_QUEUE_CAPACITY=64
LEGACY_DEDUP_WINDOW_DAYS=7

# --- GPU host (used from increment 3) ----------------------------------------
# Printed by scripts/wsl/03_check-ollama.sh. With WSL mirrored networking,
# host.containers.internal doesn't reach the GPU host: use the address the
# script recommends (the host's LAN IP), e.g. http://192.168.1.20:11434.
OLLAMA_BASE_URL=http://host.containers.internal:11434
# Model set by hardware: gpu4gb (4 GB VRAM), gpu8gb, gpu16gb or cpu. The
# models of each profile are pinned in podman/config/litellm/config.yaml.
HW_PROFILE=gpu4gb

# --- increment 1: website (edge -> web x2 + ai-api -> postgres, redis) -------
# The website: http://localhost:8080 (the only published port).
WEB_PORT=8080
# 127.0.0.1 keeps it on this machine; 0.0.0.0 exposes it on the LAN.
WEB_BIND=127.0.0.1

# Secrets: `make -C python env` fills the empty ones with random values.
# Never commit them. Changing AI_DB_PASSWORD or REDIS_PASSWORD needs
# `make -C python up` again; changing JWT_SECRET logs everyone out.
JWT_SECRET=
REDIS_PASSWORD=
AI_DB_PASSWORD=

# Password of the demo users trader1, analyst1 and admin1 (at least 12
# characters). `make -C python up` resets them to this value.
DEMO_USER_PASSWORD=premarket-demo-2026

# Sessions: 15-minute access tokens; a login lasts at most 12 hours.
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=43200
# A username is locked for LOGIN_LOCKOUT_S after this many failed logins.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_S=900

# --- increment 2: rule checks and the C++20 ingester -------------------------
# Lab universe: how many of the 50 companies in python/config/universe.yaml
# vendor-sim writes about (20 for a quick demo).
LAB_UNIVERSE_SIZE=50

# The C++20 ingester runs in parallel with the legacy one (schema ingest).
INGEST_WORKERS=4
INGEST_QUEUE_CAPACITY=64
INGEST_DEDUP_WINDOW_DAYS=7
# 1 pins worker i to CPU i (pthread affinity).
INGEST_CPU_AFFINITY=0

# SEC EDGAR requires a User-Agent with your name and contact email, e.g.
# "premarket-ai lab you@example.com". Needed to download the ticker registry
# (make -C python registry); without it FAKE_COMPANY/FAKE_TICKER are skipped.
SEC_USER_AGENT=
# Refresh the SEC ticker registry when it's older than this.
REGISTRY_MAX_AGE_DAYS=7
# A story dated this many days before the feed date is STALE.
STALE_MAX_AGE_DAYS=30

# Duplicate check (Redis L0 URL, L1 exact hash, L2 SimHash). The defaults
# were measured on vendor-sim data; see `make -C python eval`.
DEDUP_WINDOW_DAYS=7
DEDUP_SIMHASH_NGRAM=2
DEDUP_SIMHASH_MAX_HAMMING=10
DEDUP_NEAR_MAX_WORD_EDITS=3

# --- increment 3: first AI ----------------------------------------------------
# The LLM gateway key (LiteLLM master key; `make -C python env` fills it).
LLM_GATEWAY_KEY=
# Model calls in flight at once (Ollama serves 2 per model on the 4 GB GPU).
LLM_CONCURRENCY=2
# Cloud providers (optional in this increment: every task runs locally).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Dedup L3 (paraphrases), measured on vendor-sim data: cosine >= 0.90, same
# tickers and key numbers, and at least 10 differing words.
DEDUP_COSINE_MIN=0.90
DEDUP_PARAPHRASE_MIN_WORD_EDITS=10

# RAG: vector-search candidates, and sources kept after reranking.
RAG_TOP_K=20
RAG_TOP_N=5
# The reranker (a cross-encoder in text-embeddings-inference, on CPU).
# bge-reranker-base reranks 20 passages in ~10 s on 4 threads; the larger
# BAAI/bge-reranker-v2-m3 takes ~47 s (set RERANKER_MEM=6g for it).
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_MEM=4g
RERANKER_THREADS=4
# Trusted corpus: months back, newest 8-Ks per company, Fed and SEC releases.
# `make -C python corpus` needs SEC_USER_AGENT (above).
CORPUS_MONTHS=12
CORPUS_MAX_FILINGS=8
CORPUS_MAX_RELEASES=40

# --- increment 3: observability profile (Langfuse) ---------------------------
# `make -C python obs-up` starts Langfuse; set LANGFUSE_TRACING=true and run
# `make -C python up` again to trace every LLM call.
LANGFUSE_TRACING=false
LANGFUSE_PORT=3000
LANGFUSE_INIT_USER_EMAIL=admin@premarket.local
# Secrets: `make -C python env` fills the empty ones.
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_KEY_ID=
LANGFUSE_SECRET=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=

# --- increment 4: AI verification ---------------------------------------------
# Secrets: `make -C python env` fills the empty ones. The worker's and the
# MCP server's database roles, the MCP service token (clients send it as
# "Authorization: Bearer ..."), and SearXNG's secret.
WORKER_DB_PASSWORD=
MCP_DB_PASSWORD=
MCP_SERVICE_TOKEN=
SEARXNG_SECRET=

# Items below this confidence wait in the review queue (analyst1, admin1).
HITL_CONFIDENCE_MIN=0.70
# Escalate uncertain verdicts (confidence 0.50 to 0.70) to a cloud model:
# empty keeps every judgement local; cloud-openai needs OPENAI_API_KEY.
JUDGE_CLOUD_MODEL=
# The monthly cloud cap; at the cap everything stays local.
LLM_MONTHLY_BUDGET_USD=20
# Llama Guard on vendor news and on chat questions and answers.
LLAMA_GUARD=true
# Send a news item Llama Guard flags to review (and skip the judge). Off:
# the 1B guard of gpu4gb flags ordinary financial news, so on news it is
# evidence only. Turn it on with the 8B guard (gpu16gb).
GUARD_NEWS_REVIEW=false
# The classic ML baseline in the worker (FinBERT; DistilBERT once trained
# with `make -C python ml-train`).
ML_BASELINE=true
# Verification jobs one worker runs at once, and its memory.
WORKER_CONCURRENCY=2
WORKER_MEM=3g
# The MCP server for Claude Desktop / the MCP Inspector (loopback only).
MCP_BIND=127.0.0.1
MCP_PORT=8765
# Per-minute limits of the MCP tools that call outside services.
WEB_SEARCH_PER_MIN=30
PRICES_PER_MIN=30
