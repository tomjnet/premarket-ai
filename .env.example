# premarket-ai settings. Copy to .env (gitignored) and adjust:
#   cp .env.example .env
# Later increments add their keys and switches here.

# --- PostgreSQL (local lab only; pick any password) -------------------------
POSTGRES_PASSWORD=change-me-local-only

# --- vendor-sim: the synthetic news vendor ----------------------------------
# Same seed + date = same 100 items and labels.
VENDOR_SEED=42
# Items per day by kind (injection is a subset of fake). Empty = defaults.
VENDOR_MIX=real=60,fake=15,injection=2,misleading=10,duplicates=15

# --- legacy C++11 ingester ---------------------------------------------------
LEGACY_WORKERS=4
LEGACY_QUEUE_CAPACITY=64
LEGACY_DEDUP_WINDOW_DAYS=7

# --- GPU host (used from increment 3) ----------------------------------------
# Printed by scripts/wsl/03_check-ollama.sh.
OLLAMA_BASE_URL=http://host.containers.internal:11434
HW_PROFILE=gpu4gb

# --- increment 1: website (edge -> web x2 + ai-api -> postgres, redis) -------
# The website: http://localhost:8080 (the only published port).
WEB_PORT=8080
# 127.0.0.1 keeps it on this machine; 0.0.0.0 exposes it on the LAN.
WEB_BIND=127.0.0.1

# Secrets: `make -C python env` fills the empty ones with random values.
# Never commit them. Changing AI_DB_PASSWORD or REDIS_PASSWORD needs
# `make -C python up` again; changing JWT_SECRET logs everyone out.
JWT_SECRET=
REDIS_PASSWORD=
AI_DB_PASSWORD=

# Password of the demo users trader1, analyst1 and admin1 (at least 12
# characters). `make -C python up` resets them to this value.
DEMO_USER_PASSWORD=premarket-demo-2026

# Sessions: 15-minute access tokens; a login lasts at most 12 hours.
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=43200
# A username is locked for LOGIN_LOCKOUT_S after this many failed logins.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_S=900
