# premarket-ai settings. Copy to .env (gitignored) and adjust:
#   cp .env.example .env
# Later increments add their keys and switches here.

# --- PostgreSQL (local lab only; pick any password) -------------------------
POSTGRES_PASSWORD=change-me-local-only

# --- vendor-sim: the synthetic news vendor ----------------------------------
# Same seed + date = same 100 items and labels.
VENDOR_SEED=42
# Items per day by kind (injection is a subset of fake). Empty = defaults.
VENDOR_MIX=real=60,fake=15,injection=2,misleading=10,duplicates=15

# --- legacy C++11 ingester ---------------------------------------------------
LEGACY_WORKERS=4
LEGACY_QUEUE_CAPACITY=64
LEGACY_DEDUP_WINDOW_DAYS=7

# --- GPU host (used from increment 3) ----------------------------------------
# Printed by scripts/wsl/03_check-ollama.sh.
OLLAMA_BASE_URL=http://host.containers.internal:11434
HW_PROFILE=gpu4gb
