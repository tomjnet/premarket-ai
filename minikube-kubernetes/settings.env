# premarket-ai on Minikube: the non-secret settings and their defaults,
# the same as compose.yaml's ${VAR:-default}. scripts/config.sh turns this
# into the ConfigMap premarket-settings; a non-empty value for the same key
# in .env wins (BRIEF_MODEL may be empty on purpose: it keeps the brief
# local, like compose's ${BRIEF_MODEL-cloud-openai}).
# Passwords, keys and tokens are never here: they go to the Secret
# premarket-env, straight from .env.

# vendor-sim
VENDOR_SEED=42
VENDOR_MIX=
LAB_UNIVERSE_SIZE=50

# C++20 ingester
INGEST_WORKERS=4
INGEST_QUEUE_CAPACITY=64
INGEST_DEDUP_WINDOW_DAYS=7
INGEST_CPU_AFFINITY=0

# GPU host and LLM (x-ai-env). OLLAMA_BASE_URL has no default: .env must set
# it (scripts/wsl/03_check-ollama.sh prints it).
OLLAMA_BASE_URL=
HW_PROFILE=gpu4gb
LLM_CONCURRENCY=2
VECTOR_STORE=chroma
RAG_HYBRID=true
RAG_TOP_K=20
RAG_TOP_N=5
DEDUP_COSINE_MIN=0.90
DEDUP_PARAPHRASE_MIN_WORD_EDITS=10
LANGFUSE_TRACING=false
LLAMA_GUARD=true
OTEL_EXPORTER_OTLP_ENDPOINT=
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_THREADS=4

# Batch jobs (x-owner-jobs-env) and the scheduler
SEC_USER_AGENT=
REGISTRY_MAX_AGE_DAYS=7
STALE_MAX_AGE_DAYS=30
DEDUP_WINDOW_DAYS=7
DEDUP_SIMHASH_NGRAM=2
DEDUP_SIMHASH_MAX_HAMMING=10
DEDUP_NEAR_MAX_WORD_EDITS=3
CORPUS_MONTHS=12
CORPUS_MAX_FILINGS=8
CORPUS_MAX_RELEASES=40
LEGACY_PDF_ENABLED=false
RETENTION_DAYS=90
RUN_MODE=demo
LLM_MONTHLY_BUDGET_USD=20
VENDOR_CONTRACT_ITEMS=100
SLA_BACKLOG_MAX=50
SCHEDULER_CORPUS=true

# ai-api
WEB_PORT=8080
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=43200
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_S=900
CHAT_AGENTS=true
AGENT_MAX_TOOL_CALLS=3
CHAT_CACHE=true
CHAT_CACHE_TTL_S=900
CHAT_CACHE_DISTANCE=0.05
JUDGE_CLOUD_MODEL=
BRIEF_MODEL=cloud-openai

# ai-worker
HITL_CONFIDENCE_MIN=0.70
GUARD_NEWS_REVIEW=false
ML_BASELINE=true
WORKER_CONCURRENCY=2

# mcp-server
WEB_SEARCH_PER_MIN=30
PRICES_PER_MIN=30

# observability overlay
PROMETHEUS_RETENTION=15d
LANGFUSE_PORT=3000
LANGFUSE_INIT_USER_EMAIL=admin@premarket.local
