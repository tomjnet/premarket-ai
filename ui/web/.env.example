# premarket-ai web settings. Every VITE_* value ends up in the public
# bundle: never put a secret here.
#
# `make dev` passes these from the Makefile, and those values win over any
# .env file. Override them on the command line instead, for example
# `make dev VITE_API_MODE=live VITE_MOCK_TOKEN_TTL_S=60`.

# mock: the MSW mock backend in the browser (dev default).
# live: real calls to VITE_API_BASE_URL (the production build is always live).
VITE_API_MODE=mock

# Base URL of the backend. In live dev mode, Vite proxies /api to
# API_PROXY_TARGET (Makefile) with the /api prefix removed.
VITE_API_BASE_URL=/api

# Mock mode only: access-token lifetime in seconds. Set it low (for example
# 60) to exercise the refresh flow quickly.
VITE_MOCK_TOKEN_TTL_S=900
